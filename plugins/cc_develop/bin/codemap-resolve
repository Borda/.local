#!/usr/bin/env bash
# Resolve CODEMAP_ENABLED from auto/strict/off to true/false.
# Also writes currency status to ${TMPDIR:-/tmp}/dev-codemap-currency-${CSID} when
# check-index-currency is available ("current", "stale", or "no_index").
# Usage: CODEMAP_ENABLED=$(codemap-resolve "$CODEMAP_ENABLED") || exit 1
# Exits 0: prints "true" or "false" to stdout
# Exits 1: strict mode and binary/index missing — error to stderr

export CSID="${CLAUDE_CODE_SESSION_ID:-$PPID}"
_CURRENCY_FILE="${TMPDIR:-/tmp}/dev-codemap-currency-${CSID}"

MODE="${1:-auto}"

case "$MODE" in
  off|false) echo "false"; echo "off" > "$_CURRENCY_FILE"; exit 0 ;;
  true) echo "true"; exit 0 ;;
esac

# auto or strict: probe binary + index
if command -v codemap-py >/dev/null 2>&1; then
  PROJ=$(basename "$(timeout 5 git rev-parse --show-toplevel 2>/dev/null || echo 'default')")
  # Strip any chars outside safe project-name set before path interpolation.
  PROJ=$(echo "$PROJ" | tr -cd 'a-zA-Z0-9._-')
  [ -z "$PROJ" ] && PROJ="default"
  _IDX="${CODEMAP_INDEX_DIR:-.cache/codemap}"
  INDEX="${_IDX}/${PROJ}.json"
  if [ -f "$INDEX" ]; then
    # Index found — check currency when check-index-currency is on PATH
    _CIC=$(command -v check-index-currency 2>/dev/null)
    if [ -n "$_CIC" ]; then
      _CURRENCY=$(python3 "$_CIC" --index-path "$INDEX" --field status 2>/dev/null || echo "current")
      _REASON=$(python3  "$_CIC" --index-path "$INDEX" --field reason  2>/dev/null || echo "")
      echo "$_CURRENCY" > "$_CURRENCY_FILE"
      if [ "$_CURRENCY" = "stale" ]; then
        printf "⚠ codemap-py: index is stale — %s\n  Run /codemap-py:scan-codebase to refresh it.\n" "$_REASON" >&2
      fi
    else
      echo "current" > "$_CURRENCY_FILE"
    fi
    echo "true"
  elif [ "$MODE" = "strict" ]; then
    echo "no_index" > "$_CURRENCY_FILE"
    echo "! BREAKING — --codemap strict: index $INDEX not found. Run /codemap-py:scan-codebase first." >&2
    exit 1
  else
    echo "no_index" > "$_CURRENCY_FILE"
    printf "⚠ codemap-py: no index for project '%s' at %s\n  Run /codemap-py:scan-codebase to build it, then re-run this skill.\n" "$PROJ" "$INDEX" >&2
    echo "false"
  fi
elif [ "$MODE" = "strict" ]; then
  echo "no_index" > "$_CURRENCY_FILE"
  echo "! BREAKING — --codemap strict: codemap-py query not found. Install codemap-py plugin." >&2
  exit 1
else
  echo "no_index" > "$_CURRENCY_FILE"
  echo "false"
fi
