{
  "description": "Optional read-only Codex Rig shim health diagnostic.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "python3 \"$PLUGIN_ROOT/hooks/session_start.py\"",
            "statusMessage": "Checking Codex Rig shim health",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "startup|resume"
      }
    ]
  }
}
