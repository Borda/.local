{
  "description": "codemap-py plugin hooks: ambient index status injection + skill telemetry + redundant-scan guard",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/record-exhausted.py\"",
            "type": "command"
          },
          {
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/log-tool-use.py\"",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/log-tool-use.py\"",
            "type": "command"
          }
        ],
        "matcher": "Grep|Read|Glob"
      },
      {
        "hooks": [
          {
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/record-exhausted.py\"",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/log-skill-start.py\"",
            "type": "command"
          }
        ],
        "matcher": "Skill"
      },
      {
        "hooks": [
          {
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-redundant-scan.py\"",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/seed-session.py\"",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-preamble.py\"",
            "type": "command"
          }
        ]
      }
    ]
  }
}
