{
  "_comment": "Cross-language contract vectors. Consumed by test_build_blueprint_manifest.py (Python: build_blueprint_manifest) and test_blueprint_allow_js.py (JS: hooks/blueprint-allow.js). Both suites must run every array; a vector added here must pass in both languages or the manifest hash space has diverged.",
  "is_dangerous": [
    {
      "expected": false,
      "id": "safe-echo",
      "input": "echo hi"
    },
    {
      "expected": false,
      "id": "git-read-only",
      "input": "git status --short"
    },
    {
      "expected": false,
      "id": "quoted-mention-is-safe",
      "input": "echo 'rm -rf x'"
    },
    {
      "expected": true,
      "id": "rm",
      "input": "rm -rf build"
    },
    {
      "expected": true,
      "id": "absolute-path-rm",
      "input": "/bin/rm x"
    },
    {
      "expected": true,
      "id": "leading-assignment-then-rm",
      "input": "FOO=1 rm x"
    },
    {
      "expected": true,
      "id": "chmod",
      "input": "chmod +x script.py"
    },
    {
      "expected": true,
      "id": "second-segment",
      "input": "echo a && dd if=/dev/zero of=x"
    },
    {
      "expected": true,
      "id": "substitution-body",
      "input": "VAR=$(rm -rf x)"
    },
    {
      "expected": true,
      "id": "backtick-body",
      "input": "echo `pkill node`"
    },
    {
      "expected": true,
      "id": "quoted-path-substitution-body",
      "input": "BUILD=$(rm -rf \"$HOME/build\")"
    },
    {
      "expected": true,
      "id": "double-quoted-substitution-body",
      "input": "echo \"$(rm -rf /)\""
    },
    {
      "expected": true,
      "id": "double-quoted-backtick-body",
      "input": "echo \"`rm -rf /`\""
    },
    {
      "expected": false,
      "id": "single-quoted-substitution-is-literal",
      "input": "echo '$(rm -rf /)'"
    },
    {
      "expected": false,
      "id": "single-quoted-backtick-is-literal",
      "input": "echo '`rm -rf /`'"
    },
    {
      "expected": true,
      "id": "process-substitution-body",
      "input": "cat <(rm -rf /)"
    },
    {
      "expected": true,
