      "input": "cat <(git status)"
    },
    {
      "expected": false,
      "id": "bare-redirection-is-not-substitution",
      "input": "cat < notes.txt"
    },
    {
      "expected": true,
      "id": "git-push",
      "input": "git push origin main"
    },
    {
      "expected": true,
      "id": "git-push-with-c-flag",
      "input": "git -C repo push"
    },
    {
      "expected": true,
      "id": "git-force-flag",
      "input": "git checkout --force main"
    },
    {
      "expected": true,
      "id": "git-short-force-flag",
      "input": "git clean -f"
    },
    {
      "expected": true,
      "id": "git-worktree-remove",
      "input": "git worktree remove wt"
    },
    {
      "expected": true,
      "id": "eval-defers-to-rm",
      "input": "eval rm -rf /"
    },
    {
      "expected": false,
      "id": "eval-safe-argument",
      "input": "eval echo hi"
    },
    {
      "expected": true,
