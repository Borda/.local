      "input": "echo a\t# tabbed"
    },
    {
      "expected": "echo a",
      "id": "hash-at-line-start-is-comment",
      "input": "#!/usr/bin/env bash\necho a"
    },
    {
      "expected": "",
      "id": "comment-only-block-is-empty",
      "input": "# only a comment"
