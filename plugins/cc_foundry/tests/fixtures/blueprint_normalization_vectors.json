    {
      "expected": "echo ${V:-#x}",
      "id": "unquoted-param-default-survives",
      "input": "echo ${V:-#x}"
    },
    {
      "expected": "echo '# literal'",
      "id": "single-quoted-hash-survives",
      "input": "echo '# literal'"
    },
    {
      "expected": "echo \"# literal\"",
      "id": "double-quoted-hash-survives",
      "input": "echo \"# literal\""
    },
    {
      "expected": "echo \\# literal",
      "id": "escaped-hash-survives",
      "input": "echo \\# literal"
