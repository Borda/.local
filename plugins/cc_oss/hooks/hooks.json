{
  "description": "oss plugin hooks: agent routing fallback + blueprint sentinel-read auto-allow",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-router.js\"",
            "statusMessage": "Routing agent",
            "type": "command"
          }
        ],
        "matcher": "Agent"
      },
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/sentinel-read-allow.js\"",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ]
  }
}
