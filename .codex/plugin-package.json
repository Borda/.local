  "layouts": {
    "marketplace": ".agents/plugins/marketplace.json",
    "plugin_root": "plugins/codex-rig",
    "user_agents": "<CODEX_HOME>/agents",
    "user_state": "<CODEX_HOME>/codex-rig/shims"
  },
  "lifecycle": {
    "actions": [
      "doctor",
      "status",
      "install",
      "remove"
    ],
    "batch": "whole-roster",
    "bootstrap_protocol": 1,
    "create": "atomic-no-clobber",
    "hook": "bundled-opt-in-session-start-diagnostic",
    "lock": "posix-advisory",
    "marker_schema": 1,
    "mcp": "absent",
    "platform_semantics": "doctor-proven-posix-local-filesystem",
    "python": ">=3.10",
    "recovery": "rollback-only",
    "scope": "user-only",
    "state_schema": 1,
    "test_matrix": [
      "macos",
      "linux"
    ],
    "transaction_order": [
      "read-only-preflight",
      "approval",
      "lock",
      "under-lock-revalidation",
      "private-generation",
      "durable-before-images",
      "prepared-journal",
      "ordered-no-clobber-mutations",
      "atomic-committed-state",
      "committed-journal",
      "cleanup"
    ],
    "unsupported": [
      "project-scope",
      "windows",
      "network-filesystems",
      "adoption",
      "force",
      "subset-install",
      "automatic-stale-lock-takeover",
      "same-version-different-content",
      "downgrade",
      "schema-migration"
    ],
    "update_remove": "detach-validate-quarantine"
  },
  "manager_skill": "agent-shims",
  "planned_outputs": [
    {
      "owner": "installed-cache scaffold",
      "path": "plugins/codex-rig/.codex-plugin/plugin.json",
      "rule": "validator-compatible-plugin-manifest"
    },
    {
      "owner": "installed-cache scaffold",
      "path": ".agents/plugins/marketplace.json",
      "rule": "repository-codex-marketplace"
    },
    {
      "owner": "plugin-only package",
      "path": "plugins/codex-rig/package-manifest.json",
      "rule": "generated-hashes-excluding-self"
    },
    {
      "owner": "role-card port",
      "path": "plugins/codex-rig/roles/<role-id>/ROLE.md",
      "rule": "authored-canonical-card-seeded-from-agent-toml"
    },
    {
      "owner": "shim lifecycle manager",
      "path": "plugins/codex-rig/skills/agent-shims/SKILL.md",
      "rule": "publish-after-lifecycle-gates"
    },
    {
      "owner": "session diagnostic",
      "path": "plugins/codex-rig/hooks/hooks.json",
      "rule": "bundled-opt-in-diagnostic"
    }
  ],
  "plugin": "codex-rig",
  "publication": {
    "author": "Jiri Borovec",
    "curated_marketplace_required": false,
    "distribution": "public-github",
    "homepage": "https://github.com/Borda/AI-Rig",
    "license": "Apache-2.0",
    "marketplace": "borda-ai-rig",
    "publisher": "Borda",
    "repository": "https://github.com/Borda/AI-Rig"
  },
  "release_profiles": {
    "0.1.0": {
      "generated_shims": false,
      "hooks": false,
      "manager": false,
      "mcp": false
    },
    "0.2.0": {
      "generated_shims": true,
      "hooks": true,
      "manager": true,
      "mcp": false
    }
  },
  "releases": {
    "plugin_only": "0.1.0",
    "shim_manager": "0.2.0"
  },
  "rewrites": [
    {
      "from": "../_shared/",
      "scope": "skills/*/SKILL.md",
      "to": "../../shared/"
    },
    {
      "from": ".codex/calibration",
      "scope": "plugin-layout-only",
      "to": "runtime/calibration"
    },
    {
      "from": ".codex/agents/<role>.toml",
      "scope": "role-card-build",
      "to": "roles/<role>/ROLE.md"
    }
  ],
  "roles": [
    "challenger",
    "cicd-steward",
    "curator",
    "data-steward",
    "delegation-lead",
    "doc-scribe",
    "linting-expert",
    "oss-shepherd",
    "qa-specialist",
    "scientist",
    "security-auditor",
    "solution-architect",
    "squeezer",
    "sw-engineer",
    "web-explorer"
  ],
  "runtime_gates": {
    "bootstrap_compliance_required_for_shims": true,
    "cache_skill_resolution_required_for_w2": true,
    "current_active_package_oracle_required_for_shims": true,
    "shared_marketplace_name_must_coexist_with_legacy_catalog": true
  },
  "schema": 1,
  "shared_runtime": [
    "collect-diff.sh",
    "collect-pr.sh",
    "commit-response-template.md",
    "find-review-report.py",
    "helper-cli-contract.md",
    "native-skill-contract.md",
    "quality-gates.md",
    "run-gates.sh",
    "select-git-remote.py",
    "severity-map.md",
    "specialist-orchestration.md",
    "validate-artifacts.py",
    "write-result.py"
  ],
  "shim_outputs": [
    "codex-rig-challenger.toml",
    "codex-rig-cicd-steward.toml",
    "codex-rig-curator.toml",
    "codex-rig-data-steward.toml",
    "codex-rig-delegation-lead.toml",
    "codex-rig-doc-scribe.toml",
    "codex-rig-linting-expert.toml",
    "codex-rig-oss-shepherd.toml",
    "codex-rig-qa-specialist.toml",
    "codex-rig-scientist.toml",
    "codex-rig-security-auditor.toml",
    "codex-rig-solution-architect.toml",
    "codex-rig-squeezer.toml",
    "codex-rig-sw-engineer.toml",
    "codex-rig-web-explorer.toml"
  ],
  "source_mappings": [
    {
      "destination": "LICENSE",
      "mode": "copy",
      "source": "LICENSE"
    },
    {
      "destination": "NOTICE.source-reference",
      "mode": "metadata-reference-only",
      "source": "NOTICE"
    },
    {
      "destination": "skills",
      "mode": "selected-tree",
      "source": ".codex/skills"
    },
    {
      "destination": "roles",
      "mode": "compile-cards",
      "source": ".codex/agents"
    },
    {
      "destination": "shared",
      "mode": "selected-tree",
      "source": ".codex/skills/_shared"
    },
    {
      "destination": "runtime/calibration",
      "mode": "selected-tree",
      "source": ".codex/calibration"
    }
  ],
  "workflow_skills": [
    "analyse",
    "audit",
    "calibrate",
    "code-remediate",
    "code-review",
    "develop",
    "investigate",
