  "planned_outputs": [
    {"path": "plugins/codex-rig/.codex-plugin/plugin.json", "owner": "installed-cache scaffold", "rule": "validator-compatible-plugin-manifest"},
    {"path": ".agents/plugins/marketplace.json", "owner": "installed-cache scaffold", "rule": "repository-codex-marketplace"},
    {"path": "plugins/codex-rig/package-manifest.json", "owner": "plugin-only package", "rule": "generated-hashes-excluding-self"},
    {"path": "plugins/codex-rig/roles/<role-id>/ROLE.md", "owner": "role-card port", "rule": "authored-canonical-card-seeded-from-agent-toml"},
    {"path": "plugins/codex-rig/skills/agent-shims/SKILL.md", "owner": "shim lifecycle manager", "rule": "publish-after-lifecycle-gates"},
    {"path": "plugins/codex-rig/hooks/hooks.json", "owner": "session diagnostic", "rule": "bundled-opt-in-diagnostic"}
  ],
  "source_mappings": [
    {"source": "LICENSE", "destination": "LICENSE", "mode": "copy"},
    {"source": "NOTICE", "destination": "NOTICE.source-reference", "mode": "metadata-reference-only"},
    {"source": ".codex/skills", "destination": "skills", "mode": "selected-tree"},
    {"source": ".codex/agents", "destination": "roles", "mode": "compile-cards"},
    {"source": ".codex/skills/_shared", "destination": "shared", "mode": "selected-tree"},
    {"source": ".codex/calibration", "destination": "runtime/calibration", "mode": "selected-tree"}
  ],
  "rewrites": [
    {"from": "../_shared/", "to": "../../shared/", "scope": "skills/*/SKILL.md"},
    {"from": ".codex/calibration", "to": "runtime/calibration", "scope": "plugin-layout-only"},
    {"from": ".codex/agents/<role>.toml", "to": "roles/<role>/ROLE.md", "scope": "role-card-build"}
  ],
  "excluded_paths": [
    ".codex/AGENTS.md",
    ".codex/config.toml",
    ".codex/handover",
    ".codex/hooks/rtk-enforce.js",
    ".codex/logs",
    ".codex/reports",
    ".codex/skills/resolve",
    ".codex/skills/review",
    ".mcp.json",
    "__pycache__",
    ".pytest_cache",
    ".coverage"
  ],
  "publication": {
    "marketplace": "borda-ai-rig",
    "publisher": "Borda",
    "author": "Jiri Borovec",
    "repository": "https://github.com/Borda/AI-Rig",
    "homepage": "https://github.com/Borda/AI-Rig",
    "license": "Apache-2.0",
    "distribution": "public-github",
    "curated_marketplace_required": false
  },
  "runtime_gates": {
    "shared_marketplace_name_must_coexist_with_legacy_catalog": true,
    "current_active_package_oracle_required_for_shims": true,
    "bootstrap_compliance_required_for_shims": true,
    "cache_skill_resolution_required_for_w2": true
  },
  "lifecycle": {
    "scope": "user-only",
    "platform_semantics": "doctor-proven-posix-local-filesystem",
    "test_matrix": ["macos", "linux"],
    "python": ">=3.10",
    "actions": ["doctor", "status", "install", "remove"],
    "batch": "whole-roster",
    "state_schema": 1,
    "marker_schema": 1,
    "bootstrap_protocol": 1,
    "recovery": "rollback-only",
    "lock": "posix-advisory",
    "create": "atomic-no-clobber",
    "update_remove": "detach-validate-quarantine",
    "mcp": "absent",
    "hook": "bundled-opt-in-session-start-diagnostic",
    "unsupported": [
      "project-scope",
      "windows",
      "network-filesystems",
      "adoption",
      "force",
      "subset-install",
      "automatic-stale-lock-takeover",
      "same-version-different-content",
      "downgrade",
      "schema-migration"
    ],
    "transaction_order": [
      "read-only-preflight",
      "approval",
      "lock",
      "under-lock-revalidation",
      "private-generation",
      "durable-before-images",
      "prepared-journal",
      "ordered-no-clobber-mutations",
      "atomic-committed-state",
      "committed-journal",
      "cleanup"
    ]
  },
  "layouts": {
    "plugin_root": "plugins/codex-rig",
    "marketplace": ".agents/plugins/marketplace.json",
    "user_agents": "<CODEX_HOME>/agents",
    "user_state": "<CODEX_HOME>/codex-rig/shims"
  }
}
