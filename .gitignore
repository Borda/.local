# Agent handover artifacts (ephemeral patch files)
.codex/handover/

# Codex CI harness artifacts generated during local and CI runs
.github/codex-harness-results/

# Delegation log (local runtime data, not source)
.codex/logs/
.codex/reports/

# Hook runtime state and invocation logs
.claude/state/
.claude/logs/
.claude/worktrees/
.claude/scheduled_tasks.lock

# Skill run artifacts and temp outputs (ephemeral, TTL-managed)
.cache/
.notes/
.plans/
.developments/
.experiments/
.investigate/
.reports/
.temp/
.outputs/
docs/specs/

# Agent auto-memory (machine-local, not source)
.claude/agent-memory/
benchmarks/.claude/
plugins/*/.claude/

# Local Claude overrides (not synced to ~/.claude/)
*.local.md

# JetBrains IDEs
.idea/
*.iml
*.iws
*.ipr
out/
.idea_modules/

# Benchmarks and logs
benchmarks/results/
pytorch-lightning-master/

# Documentation build artifacts
site/

#__pycache__
__pycache__/
*.py[cod]
*$py.class

.coverage
uv.lock
